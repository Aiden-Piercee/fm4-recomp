--- a/tests/unit/CMakeLists.txt
+++ b/tests/unit/CMakeLists.txt
@@ -18,6 +18,7 @@ add_executable(unit_tests
     ppc/stack_test.cpp
     ppc/vector_math_test.cpp
     system/guest_path_test.cpp
