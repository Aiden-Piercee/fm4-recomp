     .lifecycle(rex::cvar::Lifecycle::kHotReload);
 
+REXCVAR_DEFINE_BOOL(d3d12_readback_resolve_deferred_sync, false, "GPU/D3D12",
+                    "With full resolve readback through the guest-RAM host copy, wait for the "
