     .lifecycle(rex::cvar::Lifecycle::kHotReload);
@@ -2293,6 +2299,22 @@ void D3D12CommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbu
   EndSubmission(true);
 }
 
+void D3D12CommandProcessor::FlushDeferredReadbackSync() {
+  if (!readback_host_copy_sync_pending_) {
+    return;
+  }
+  readback_host_copy_sync_pending_ = false;
+  const auto wait_begin = std::chrono::steady_clock::now();
+  const bool wait_ok = AwaitAllQueueOperationsCompletion();
+  ++rb_stat_sync_waits_;
+  rb_stat_wait_us_ += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                   std::chrono::steady_clock::now() - wait_begin)
+                                   .count());
+  if (!wait_ok) {
+    REXGPU_WARN("Deferred resolve host copy queue wait failed");
+  }
+}
+
 void D3D12CommandProcessor::OnPrimaryBufferEnd() {
   if (REXCVAR_GET(d3d12_submit_on_primary_buffer_end) && submission_open_ &&
       CanEndSubmissionImmediately()) {
