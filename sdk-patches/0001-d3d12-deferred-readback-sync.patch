Subject: perf(d3d12): defer resolve readback sync to guest-visible sync points

With readback_resolve = "full" and d3d12_readback_resolve_host_copy, the command
processor waited for the GPU after every resolve. d3d12_readback_resolve_deferred_sync
(default off) records the copy into guest RAM and waits once, at the next point where
the guest can observe command-stream progress (fences, interrupts, memory and
scratch-register writebacks, swaps and stalls), so the guest never sees a signal
before the resolved data is in guest RAM.
---
diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index 12efe6d..e80a69c 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -184,6 +184,12 @@ class CommandProcessor {
   virtual void OnGammaRampPWLValueWritten() {}
 
   virtual void MakeCoherent();
+  // Called on the command processor thread wherever the guest can observe
+  // command-stream progress: fences, interrupts, memory and scratch-register
+  // writebacks, swaps and command-processor stalls. A backend that defers
+  // resolve-readback synchronization must complete pending readbacks here so
+  // the guest never sees a signal before the resolved data is in guest RAM.
+  virtual void FlushDeferredReadbackSync() {}
   virtual void PrepareForWait();
   virtual void ReturnFromWait();
 
diff --git a/include/rex/graphics/d3d12/command_processor.h b/include/rex/graphics/d3d12/command_processor.h
index 7384494..a03d5fa 100644
--- a/include/rex/graphics/d3d12/command_processor.h
+++ b/include/rex/graphics/d3d12/command_processor.h
@@ -218,6 +218,8 @@ class D3D12CommandProcessor : public CommandProcessor {
 
   void OnPrimaryBufferEnd() override;
 
+  void FlushDeferredReadbackSync() override;
+
   Shader* LoadShader(xenos::ShaderType shader_type, uint32_t guest_address,
                      const uint32_t* host_address, uint32_t dword_count) override;
 
@@ -397,7 +399,12 @@ class D3D12CommandProcessor : public CommandProcessor {
   uint32_t rb_stat_requests_ = 0;
   uint32_t rb_stat_skips_ = 0;
   uint32_t rb_stat_sync_waits_ = 0;
+  uint32_t rb_stat_deferred_ = 0;
   uint64_t rb_stat_wait_us_ = 0;
+  // A full-mode host-copy resolve readback has been recorded but not awaited
+  // (d3d12_readback_resolve_deferred_sync). Completed by
+  // FlushDeferredReadbackSync at the next guest-observable sync point.
+  bool readback_host_copy_sync_pending_ = false;
   std::unordered_map<uint64_t, uint32_t> rb_stat_key_counts_;
   static constexpr uint32_t kReadbackBufferSizeIncrement = 16 * 1024 * 1024;
   static constexpr size_t kMaxReadbackBuffers = 256;
