-          "waiting; top:{}",
-          rb_stat_requests_, rb_stat_key_counts_.size(), rb_stat_skips_, rb_stat_sync_waits_,
-          rb_stat_wait_us_ / 1000, top);
-      rb_stat_requests_ = rb_stat_skips_ = rb_stat_sync_waits_ = 0;
+          "readback stats/300f: {} requests, {} keys, {} auto-skips, {} deferred, {} sync waits, "
+          "{} ms waiting; top:{}",
+          rb_stat_requests_, rb_stat_key_counts_.size(), rb_stat_skips_, rb_stat_deferred_,
+          rb_stat_sync_waits_, rb_stat_wait_us_ / 1000, top);
+      rb_stat_requests_ = rb_stat_skips_ = rb_stat_sync_waits_ = rb_stat_deferred_ = 0;
       rb_stat_wait_us_ = 0;
       rb_stat_key_counts_.clear();
       rb_stat_window_start_frame_ = frame_current_;
@@ -3208,6 +3230,14 @@ bool D3D12CommandProcessor::IssueCopy_ReadbackResolvePath() {
   }
 
   if (use_resolve_host_copy) {
+    if (REXCVAR_GET(d3d12_readback_resolve_deferred_sync)) {
+      // The copy into guest RAM is recorded; the guest can only rely on it
+      // after a later fence, interrupt or other sync point, which will await
