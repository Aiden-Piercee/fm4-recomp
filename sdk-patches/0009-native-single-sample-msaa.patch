Subject: perf(d3d12): optional single-sample MSAA surfaces for the native executor

native_executor_single_sample_msaa (default off) keeps the guest's 2x/4x MSAA EDRAM layout but creates those surfaces, and the host pipelines that draw into them, with one sample. Transfers, resolves and the words path read and write them through host sample mode 3 (guest samples map to host sample 0), which the native EDRAM shaders already support. On weak GPUs this removes most multisampled transfer and resolve bandwidth, at the cost of anti-aliasing.
---
diff --git a/include/rex/graphics/d3d12/native_executor.h b/include/rex/graphics/d3d12/native_executor.h
index ee310ee..ad4550a 100644
--- a/include/rex/graphics/d3d12/native_executor.h
+++ b/include/rex/graphics/d3d12/native_executor.h
@@ -94,6 +94,8 @@ class NativeExecutor {
   ~NativeExecutor();
 
   bool Initialize(const NativeExecutorConfig& config);
+  // native_executor_single_sample_msaa: guest MSAA surfaces have one host sample.
+  bool single_sample_msaa() const { return single_sample_msaa_; }
   void Shutdown();
 
   // Before the targets are bound for a draw: derives the surfaces the draw
@@ -221,6 +223,9 @@ class NativeExecutor {
   void ClaimTileRect(const SurfaceKey& key, uint32_t column_first, uint32_t row_first,
                      uint32_t column_end, uint32_t row_end);
   ID3D12PipelineState* GetTransferPipeline(const TransferPipelineKey& key);
+  // Host sample mode of a surface's layout constant (see native_edram.hlsli):
+  // 0 as the guest, 1 native 2x, 2 2x stored as 4x, 3 MSAA over one sample.
+  static uint32_t HostSampleMode(const Surface& surface);
   uint32_t LayoutConstant(const Surface& surface) const;
   // Splits the resolve's pixel rectangle into rectangles per owning surface.
   void GetResolveSources(const SurfaceKey& resolve_key, int32_t x0, int32_t y0, int32_t x1,
@@ -230,6 +235,7 @@ class NativeExecutor {
   // (SV_StencilRef), native_executor_stencil_ref_transfers.
   static constexpr uint32_t kTransferDestDepthStencilRef = 32;
   bool stencil_ref_transfers_ = false;
+  bool single_sample_msaa_ = false;
   Microsoft::WRL::ComPtr<ID3DBlob> stencil_ref_transfer_ps_[2];  // [dest msaa]
   // Runtime HLSL compilation with D3DCompiler_47.dll (null on failure).
   Microsoft::WRL::ComPtr<ID3DBlob> CompileRuntimeShader(const char* source, size_t source_size,
