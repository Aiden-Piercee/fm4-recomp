Subject: perf: optional precise guest vblank timer

---
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index cf199c5..a3fc5d5 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -17,6 +17,7 @@
 #include <functional>
 #include <memory>
 #include <mutex>
+#include <thread>
 #include <utility>
 
 #include <rex/cvar.h>
@@ -46,6 +47,11 @@ REXCVAR_DEFINE_INT32(vblank_frequency_override, 0, "GPU",
     .range(0, 1000)
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
+REXCVAR_DEFINE_BOOL(vblank_precise_timer, false, "GPU",
+                    "Deliver guest vblanks on time: sleep until shortly before each vblank, "
+                    "then wait the rest precisely. Removes the 1-2 ms jitter of a plain 1 ms "
+                    "sleep at the cost of a little CPU time on the vblank thread.");
+
 REXCVAR_DEFINE_BOOL(store_shaders, true, "GPU",
                     "Store shaders persistently and load them when loading games to avoid "
                     "runtime spikes and freezes when playing the game not for the first time.");
@@ -181,7 +187,23 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
             MarkVblank();
             last_frame_time += interval_ticks;
           }
-          rex::thread::Sleep(std::chrono::milliseconds(1));
+          if (REXCVAR_GET(vblank_precise_timer)) {
+            // Sleep only while more than ~2 ms remain (a 1 ms sleep can overshoot
+            // by 1-2 ms), then yield until the vblank is due.
+            uint64_t next_vblank = last_frame_time + interval_ticks;
+            uint64_t coarse_margin = std::max(uint64_t(1), guest_tick_frequency / 500);
+            uint64_t now = chrono::Clock::QueryGuestTickCount();
+            if (next_vblank > now && next_vblank - now > coarse_margin) {
+              rex::thread::Sleep(std::chrono::milliseconds(1));
+            } else {
+              while (vsync_worker_running_ &&
+                     chrono::Clock::QueryGuestTickCount() < next_vblank) {
+                std::this_thread::yield();
+              }
+            }
+          } else {
+            rex::thread::Sleep(std::chrono::milliseconds(1));
+          }
         }
         return 0;
       }));
