From 36d18763dbc00e0030bfb87a36d33b39cb7835cf Mon Sep 17 00:00:00 2001
From: "FM4 perf (local)" <perf@local>
Date: Fri, 16 Oct 2026 02:05:34 +0000
Subject: [PATCH] perf: add hitch logging and an optional present FPS cap

frame_hitch_log_ms logs a per-frame breakdown (CP idle, WAIT_REG_MEM,
GPU wait, CP busy) for frames slower than the threshold, to find what
the remaining ~50 ms hitches are. present_fps_limit caps guest swaps,
so a 120 Hz guest vblank does not run menus at 120 FPS.
---
 include/rex/graphics/command_processor.h |  8 ++++
 src/graphics/command_processor.cpp       | 53 ++++++++++++++++++++++++
 2 files changed, 61 insertions(+)

diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index dc582de..d62037a 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -333,6 +333,14 @@ class CommandProcessor {
   uint64_t frame_stats_idle_us_ = 0;
   uint64_t frame_stats_wait_reg_us_ = 0;
   uint64_t frame_stats_gpu_wait_us_ = 0;
+  // Window totals at the previous swap, for per-frame hitch breakdowns.
+  uint64_t frame_stats_snap_idle_us_ = 0;
+  uint64_t frame_stats_snap_wait_reg_us_ = 0;
+  uint64_t frame_stats_snap_gpu_wait_us_ = 0;
+  uint64_t frame_stats_frame_index_ = 0;
+  // present_fps_limit pacing.
+  void ApplyPresentFpsLimit();
+  std::chrono::steady_clock::time_point present_limit_next_{};
 
  private:
   reg::DC_LUT_30_COLOR gamma_ramp_256_entry_table_[256] = {};
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 5165937..4fff260 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -16,6 +16,7 @@
 #include <cstring>
 #include <string>
 #include <string_view>
+#include <thread>
 #include <vector>
 
 #include <fmt/format.h>
@@ -44,6 +45,12 @@ REXCVAR_DEFINE_BOOL(frame_time_stats, true, "GPU",
                     "every frame_time_stats_window swaps");
 REXCVAR_DEFINE_INT32(frame_time_stats_window, 300, "GPU",
                      "Swaps per frame_time_stats log line");
+REXCVAR_DEFINE_INT32(frame_hitch_log_ms, 0, "GPU",
+                     "With frame_time_stats: log a breakdown of every frame slower than this many "
+                     "ms (0 = off)");
+REXCVAR_DEFINE_INT32(present_fps_limit, 0, "GPU",
+                     "Cap guest swaps to this many per second (0 = off). Useful with "
+                     "vblank_frequency_override so menus do not run faster than the display");
 REXCVAR_DEFINE_INT32(deferred_readback_flush_mask, -1, "GPU",
                      "Experimental: guest sync points where deferred resolve readback is awaited "
                      "(bit mask; bit 0 idle, 1 scratch reg, 2 interrupt, 3 swap, 4 WAIT_REG_MEM "
@@ -1147,6 +1154,7 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
   reader->AdvanceRead((count - 4) * sizeof(uint32_t));
 
   FlushDeferredReadbackSyncAt(3);
+  ApplyPresentFpsLimit();
   IssueSwap(frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
   RecordFrameTimeStats();
 
@@ -1154,18 +1162,62 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
   return true;
 }
 
+void CommandProcessor::ApplyPresentFpsLimit() {
+  const int32_t limit = REXCVAR_GET(present_fps_limit);
+  if (limit <= 0) {
+    present_limit_next_ = {};
+    return;
+  }
+  const auto interval = std::chrono::nanoseconds(1000000000LL / limit);
+  auto now = std::chrono::steady_clock::now();
+  if (present_limit_next_ != std::chrono::steady_clock::time_point{} && now < present_limit_next_) {
+    // Coarse sleep, then spin the last ~1.5 ms for an accurate deadline.
+    const auto spin_from = present_limit_next_ - std::chrono::microseconds(1500);
+    if (now < spin_from) {
+      std::this_thread::sleep_until(spin_from);
+    }
+    while (std::chrono::steady_clock::now() < present_limit_next_) {
+      std::this_thread::yield();
+    }
+    now = std::chrono::steady_clock::now();
+  }
+  // Schedule the next slot from the previous deadline to keep an even cadence,
+  // but don't try to catch up after a long frame.
+  if (present_limit_next_ == std::chrono::steady_clock::time_point{} ||
+      now - present_limit_next_ > interval) {
+    present_limit_next_ = now + interval;
+  } else {
+    present_limit_next_ += interval;
+  }
+}
+
 void CommandProcessor::RecordFrameTimeStats() {
   if (!REXCVAR_GET(frame_time_stats)) {
     return;
   }
   const auto now = std::chrono::steady_clock::now();
   const uint64_t vblank = graphics_system_ ? graphics_system_->vblank_count() : 0;
+  ++frame_stats_frame_index_;
   if (frame_stats_last_swap_ != std::chrono::steady_clock::time_point{}) {
     float ms = std::chrono::duration<float, std::milli>(now - frame_stats_last_swap_).count();
     frame_stats_ms_.push_back(ms);
     uint64_t vblanks = vblank - frame_stats_last_vblank_;
     frame_stats_vblank_hist_[std::min<uint64_t>(vblanks, 3)]++;
+    const int32_t hitch_ms = REXCVAR_GET(frame_hitch_log_ms);
+    if (hitch_ms > 0 && ms > float(hitch_ms)) {
+      const double idle = (frame_stats_idle_us_ - frame_stats_snap_idle_us_) / 1000.0;
+      const double wrm = (frame_stats_wait_reg_us_ - frame_stats_snap_wait_reg_us_) / 1000.0;
+      const double gpu = (frame_stats_gpu_wait_us_ - frame_stats_snap_gpu_wait_us_) / 1000.0;
+      REXGPU_INFO(
+          "frame hitch #{}: {:.1f} ms, {} vblanks | cp idle {:.1f} ms (waiting for the game), "
+          "wait_reg_mem {:.1f} ms, gpu wait {:.1f} ms, cp busy {:.1f} ms",
+          frame_stats_frame_index_, ms, vblanks, idle, wrm, gpu,
+          std::max(0.0, double(ms) - idle - wrm - gpu));
+    }
   }
+  frame_stats_snap_idle_us_ = frame_stats_idle_us_;
+  frame_stats_snap_wait_reg_us_ = frame_stats_wait_reg_us_;
+  frame_stats_snap_gpu_wait_us_ = frame_stats_gpu_wait_us_;
   frame_stats_last_swap_ = now;
   frame_stats_last_vblank_ = vblank;
 
@@ -1205,6 +1257,7 @@ void CommandProcessor::RecordFrameTimeStats() {
       frame_stats_wait_reg_us_ / 1000.0 / frame_stats_ms_.size(),
       frame_stats_gpu_wait_us_ / 1000.0 / frame_stats_ms_.size(), worst);
   frame_stats_idle_us_ = frame_stats_wait_reg_us_ = frame_stats_gpu_wait_us_ = 0;
+  frame_stats_snap_idle_us_ = frame_stats_snap_wait_reg_us_ = frame_stats_snap_gpu_wait_us_ = 0;
   frame_stats_ms_.clear();
   std::fill(std::begin(frame_stats_vblank_hist_), std::end(frame_stats_vblank_hist_), 0u);
 }
