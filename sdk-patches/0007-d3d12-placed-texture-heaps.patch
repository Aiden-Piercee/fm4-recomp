+  // Placed texture heaps (d3d12_texture_placed_heaps). Creating a committed
+  // resource allocates driver memory every time (about 0.5 ms each on some
+  // drivers), which stalls the command processor when the game streams many
+  // textures in one frame. Placing them in big pre-made heaps avoids that.
+  struct TextureHeap {
+    Microsoft::WRL::ComPtr<ID3D12Heap> heap;
+    // Free ranges, offset -> size, coalesced.
+    std::map<uint64_t, uint64_t> free_ranges;
+  };
