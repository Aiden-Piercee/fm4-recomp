+  void FreeTextureHeapRange(uint32_t heap_index, uint64_t offset, uint64_t size);
+  ID3D12Resource* CreatePlacedTexture(D3D12_RESOURCE_DESC& desc,
+                                      D3D12_RESOURCE_STATES initial_state,
+                                      uint32_t& heap_index_out, uint64_t& offset_out,
+                                      uint64_t& size_out);
+  std::vector<TextureHeap> texture_heaps_;
+  uint64_t texture_heap_size_ = 0;
   // Load pipelines for resolution-scaled resolve targets.
   std::array<Microsoft::WRL::ComPtr<ID3D12PipelineState>, kLoadShaderCount> load_pipelines_scaled_;
 
