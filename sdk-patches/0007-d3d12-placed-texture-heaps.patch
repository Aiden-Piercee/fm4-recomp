+
+bool D3D12TextureCache::CreateTextureHeap() {
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  D3D12_HEAP_DESC heap_desc = {};
+  heap_desc.SizeInBytes = texture_heap_size_;
+  heap_desc.Properties = ui::d3d12::util::kHeapPropertiesDefault;
+  heap_desc.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+  heap_desc.Flags =
+      D3D12_HEAP_FLAG_ALLOW_ONLY_NON_RT_DS_TEXTURES | provider.GetHeapFlagCreateNotZeroed();
+  TextureHeap texture_heap;
+  if (FAILED(device->CreateHeap(&heap_desc, IID_PPV_ARGS(&texture_heap.heap)))) {
+    REXGPU_WARN("Failed to create a {} MB placed texture heap", texture_heap_size_ >> 20);
+    return false;
+  }
+  texture_heap.free_ranges.emplace(uint64_t(0), texture_heap_size_);
+  texture_heaps_.push_back(std::move(texture_heap));
+  if (HitchStats* stats = hitch_stats_if_timing()) {
+    ++stats->heaps_created;
+  }
+  return true;
+}
+
+bool D3D12TextureCache::AllocateTextureHeapRange(uint64_t size, uint64_t alignment,
+                                                 uint32_t& heap_index_out,
+                                                 uint64_t& offset_out) {
+  for (uint32_t heap_index = 0; heap_index < uint32_t(texture_heaps_.size()); ++heap_index) {
+    std::map<uint64_t, uint64_t>& free_ranges = texture_heaps_[heap_index].free_ranges;
+    for (auto it = free_ranges.begin(); it != free_ranges.end(); ++it) {
+      uint64_t range_start = it->first;
+      uint64_t range_end = it->first + it->second;
+      uint64_t aligned_start = (range_start + alignment - 1) / alignment * alignment;
+      if (aligned_start + size > range_end) {
+        continue;
+      }
+      free_ranges.erase(it);
+      if (aligned_start > range_start) {
+        free_ranges.emplace(range_start, aligned_start - range_start);
+      }
+      if (aligned_start + size < range_end) {
+        free_ranges.emplace(aligned_start + size, range_end - (aligned_start + size));
+      }
+      heap_index_out = heap_index;
+      offset_out = aligned_start;
+      return true;
+    }
+  }
+  return false;
+}
+
+void D3D12TextureCache::FreeTextureHeapRange(uint32_t heap_index, uint64_t offset, uint64_t size) {
+  if (heap_index >= texture_heaps_.size() || !size) {
+    return;
+  }
+  std::map<uint64_t, uint64_t>& free_ranges = texture_heaps_[heap_index].free_ranges;
+  auto it = free_ranges.emplace(offset, size).first;
+  // Merge with the next range.
+  auto next_it = std::next(it);
+  if (next_it != free_ranges.end() && it->first + it->second == next_it->first) {
+    it->second += next_it->second;
+    free_ranges.erase(next_it);
+  }
+  // Merge with the previous range.
+  if (it != free_ranges.begin()) {
+    auto prev_it = std::prev(it);
+    if (prev_it->first + prev_it->second == it->first) {
+      prev_it->second += it->second;
+      free_ranges.erase(it);
+    }
+  }
+}
+
+ID3D12Resource* D3D12TextureCache::CreatePlacedTexture(D3D12_RESOURCE_DESC& desc,
+                                                       D3D12_RESOURCE_STATES initial_state,
+                                                       uint32_t& heap_index_out,
+                                                       uint64_t& offset_out, uint64_t& size_out) {
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  // Try the 4 KB small-resource alignment first, as the driver allows it only
+  // for small textures, and fall back to the default 64 KB.
+  desc.Alignment = D3D12_SMALL_RESOURCE_PLACEMENT_ALIGNMENT;
+  D3D12_RESOURCE_ALLOCATION_INFO allocation_info = device->GetResourceAllocationInfo(0, 1, &desc);
+  if (allocation_info.SizeInBytes == UINT64_MAX ||
+      allocation_info.Alignment != D3D12_SMALL_RESOURCE_PLACEMENT_ALIGNMENT) {
+    desc.Alignment = 0;
+    allocation_info = device->GetResourceAllocationInfo(0, 1, &desc);
+  }
+  if (allocation_info.SizeInBytes == UINT64_MAX ||
+      allocation_info.SizeInBytes > texture_heap_size_ / 2) {
     return nullptr;
   }
-  return std::unique_ptr<Texture>(new D3D12Texture(*this, key, resource.Get(), resource_state));
+  uint64_t size = allocation_info.SizeInBytes;
+  uint64_t alignment = std::max(uint64_t(allocation_info.Alignment),
+                                uint64_t(D3D12_SMALL_RESOURCE_PLACEMENT_ALIGNMENT));
+  uint32_t heap_index;
+  uint64_t offset;
+  if (!AllocateTextureHeapRange(size, alignment, heap_index, offset)) {
+    if (!CreateTextureHeap() || !AllocateTextureHeapRange(size, alignment, heap_index, offset)) {
+      return nullptr;
+    }
+  }
+  ID3D12Resource* resource = nullptr;
+  if (FAILED(device->CreatePlacedResource(texture_heaps_[heap_index].heap.Get(), offset, &desc,
+                                          initial_state, nullptr, IID_PPV_ARGS(&resource)))) {
+    FreeTextureHeapRange(heap_index, offset, size);
+    return nullptr;
+  }
+  // The memory may have belonged to a destroyed texture.
+  command_processor_.PushAliasingBarrier(nullptr, resource);
+  if (HitchStats* stats = hitch_stats_if_timing()) {
+    ++stats->placed;
+  }
+  heap_index_out = heap_index;
+  offset_out = offset;
+  size_out = size;
+  return resource;
 }
 
