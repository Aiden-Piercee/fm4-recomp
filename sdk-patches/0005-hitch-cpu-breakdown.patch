+std::string D3D12CommandProcessor::FrameHitchDetails() const {
+  static const char* kNames[kHitchCount] = {"primitives", "targets", "pipelines", "textures",
+                                            "bindings",   "vertex_buffers", "resolves", "swap",
+                                            "submit"};
+  std::string details = fmt::format(" cpu ms:");
+  for (uint32_t i = 0; i < kHitchCount; ++i) {
+    if (hitch_us_[i] >= 500) {
+      details += fmt::format(" {}={:.1f}", kNames[i], hitch_us_[i] / 1000.0);
+    }
+  }
+  details += fmt::format(" | draws={} resolves={} submissions={}", hitch_draws_, hitch_resolves_,
+                         hitch_submissions_);
+  return details;
+}
+
+void D3D12CommandProcessor::ResetFrameHitchDetails(bool enable_timing) {
+  hitch_timing_ = enable_timing;
+  std::fill(std::begin(hitch_us_), std::end(hitch_us_), uint64_t(0));
+  hitch_draws_ = hitch_resolves_ = hitch_submissions_ = 0;
+}
