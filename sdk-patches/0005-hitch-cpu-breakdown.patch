Subject: perf: break hitch frames down by command-processor CPU work

While frame_hitch_log_ms is set, time primitive processing, render
target setup, pipeline configuration, texture requests, bindings,
vertex buffer uploads, resolves, swap and command list replay per
frame, and append the totals to each hitch line.
---
diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index b4ddc91..3931827 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -191,6 +191,9 @@ class CommandProcessor {
   // resolve-readback synchronization must complete pending readbacks here so
   // the guest never sees a signal before the resolved data is in guest RAM.
   virtual void FlushDeferredReadbackSync() {}
+  // Per-frame CPU time breakdown for frame_hitch_log_ms lines (backend-specific).
+  virtual std::string FrameHitchDetails() const { return {}; }
+  virtual void ResetFrameHitchDetails(bool /*enable_timing*/) {}
   // FlushDeferredReadbackSync at a numbered guest sync point (bit index in the
   // deferred_readback_flush_mask cvar): 0 idle, 1 scratch register write,
   // 2 interrupt, 3 swap, 4 WAIT_REG_MEM stall, 5 REG_TO_MEM, 6 MEM_WRITE,
diff --git a/include/rex/graphics/d3d12/command_processor.h b/include/rex/graphics/d3d12/command_processor.h
index 82d94d0..10b8078 100644
--- a/include/rex/graphics/d3d12/command_processor.h
+++ b/include/rex/graphics/d3d12/command_processor.h
@@ -220,6 +220,49 @@ class D3D12CommandProcessor : public CommandProcessor {
   void OnPrimaryBufferEnd() override;
 
   void FlushDeferredReadbackSync() override;
+  std::string FrameHitchDetails() const override;
+  void ResetFrameHitchDetails(bool enable_timing) override;
+
+  // CPU time spent per category since the last swap (frame_hitch_log_ms).
+  enum HitchCategory : uint32_t {
+    kHitchPrimitives,
+    kHitchTargets,
+    kHitchPipeline,
+    kHitchTextures,
+    kHitchBindings,
+    kHitchVertexBuffers,
+    kHitchResolve,
+    kHitchSwap,
+    kHitchSubmit,
+    kHitchCount,
+  };
+  uint64_t hitch_us_[kHitchCount] = {};
+  uint32_t hitch_draws_ = 0;
+  uint32_t hitch_resolves_ = 0;
+  uint32_t hitch_submissions_ = 0;
+  // Timing only runs while frame_hitch_log_ms is set (updated every swap).
+  bool hitch_timing_ = false;
+  struct HitchScope {
+    uint64_t* acc;
+    std::chrono::steady_clock::time_point begin;
+    explicit HitchScope(uint64_t* accumulator)
+        : acc(accumulator),
+          begin(accumulator ? std::chrono::steady_clock::now()
+                            : std::chrono::steady_clock::time_point{}) {}
+    ~HitchScope() {
+      if (acc) {
+        *acc += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                             std::chrono::steady_clock::now() - begin)
+                             .count());
+      }
+    }
+  };
+  uint64_t* HitchSlot(uint32_t category) { return hitch_timing_ ? &hitch_us_[category] : nullptr; }
+  template <typename F>
+  auto HitchTime(uint32_t category, F&& f) {
+    HitchScope scope(HitchSlot(category));
+    return f();
+  }
 
   Shader* LoadShader(xenos::ShaderType shader_type, uint32_t guest_address,
                      const uint32_t* host_address, uint32_t dword_count) override;
