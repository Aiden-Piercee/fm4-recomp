@@ -0,0 +1,59 @@
+#pragma once
+/**
+ ******************************************************************************
+ * Native render executor for the ReXGlue SDK (opt-in D3D12 render path)      *
+ ******************************************************************************
+ * Ported from shiftglue-sdk (Pinyon Shift), commit 0038a40, file include/rex/graphics/fh1_executor_counters.h.
+ * Copyright (c) 2026, Tom Clay <tomc@tctechstuff.com>
+ * Portions derived from the Xenia project:
+ * Copyright (c) 2022, Ben Vanik and Xenia project contributors.
+ * Released under the BSD 3-Clause License - see
+ * src/graphics/d3d12/NATIVE_EXECUTOR_LICENSE.txt for the full text.
+ *
+ * @modified    FM4 recompilation project, 2026 - adapted to this SDK fork as
+ *              render_target_path_d3d12 = "native"; FH1-only features
+ *              (frame census/dumps/replay, shader packs, GPU profiling,
+ *              title gates) removed; resolve read-back delegated to the
+ *              command processor's readback_resolve modes.
+ */
+
+// Counters of the native executor (NP-9.0): why work was skipped (a
+// draw, resolve or transfer the native path could not take) and how often
+// each path ran. API-agnostic; logged periodically as name=count lists.
+
+#include <cstdint>
+#include <map>
+#include <unordered_map>
+#include <string>
+
+namespace rex::graphics {
+
+class NativeExecutorCounters {
+ public:
+  // Reasons and stats are string literals: keyed by address, so counting
+  // neither builds a string nor compares one.
+  void Skip(const char* reason, uint64_t count = 1) { skips_[reason] += count; }
+  void Count(const char* stat, uint64_t count = 1) { stats_[stat] += count; }
+
+  std::string FormatSkips() const { return Format(skips_); }
+  std::string FormatStats() const { return Format(stats_); }
+
+ private:
+  static std::string Format(const std::unordered_map<const char*, uint64_t>& counts) {
+    // By name, merging equal literals at different addresses.
+    std::map<std::string, uint64_t> sorted;
+    for (const auto& [name, count] : counts) {
+      sorted[name] += count;
+    }
+    std::string text;
+    for (const auto& [name, count] : sorted) {
+      text += (text.empty() ? "" : ",") + name + "=" + std::to_string(count);
+    }
+    return text;
+  }
+
+  std::unordered_map<const char*, uint64_t> skips_;
+  std::unordered_map<const char*, uint64_t> stats_;
+};
+
+}  // namespace rex::graphics
