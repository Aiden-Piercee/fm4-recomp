+
+bool NativeExecutor::PlanCopy(CopyPlan& plan) {
+  plan = CopyPlan();
+  const NativeResolveFlags flags{config_.depth_float24_round, config_.gamma_as_unorm16,
+                              config_.fixed16_truncated};
+  if (!NativePlanResolve(register_file_, memory_, *config_.trace_writer, flags, plan)) {
+    return false;
+  }
+  if (plan.copy) {
+    GetResolveSources(plan.resolve_key, plan.x0, plan.y0, plan.x1, plan.y1, plan.sources);
+  }
+  return true;
+}
