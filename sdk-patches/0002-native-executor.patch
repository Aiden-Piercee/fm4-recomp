+void CommandProcessor::RecordFrameTimeStats() {
+  if (!REXCVAR_GET(frame_time_stats)) {
+    return;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  const uint64_t vblank = graphics_system_ ? graphics_system_->vblank_count() : 0;
+  if (frame_stats_last_swap_ != std::chrono::steady_clock::time_point{}) {
+    float ms = std::chrono::duration<float, std::milli>(now - frame_stats_last_swap_).count();
+    frame_stats_ms_.push_back(ms);
+    uint64_t vblanks = vblank - frame_stats_last_vblank_;
+    frame_stats_vblank_hist_[std::min<uint64_t>(vblanks, 3)]++;
+  }
+  frame_stats_last_swap_ = now;
+  frame_stats_last_vblank_ = vblank;
+
+  int32_t window = std::max(30, REXCVAR_GET(frame_time_stats_window));
+  if (frame_stats_ms_.size() < size_t(window)) {
+    return;
+  }
+  std::vector<float> sorted = frame_stats_ms_;
+  std::sort(sorted.begin(), sorted.end());
+  double total = 0.0;
+  uint32_t over_17 = 0, over_34 = 0, over_50 = 0;
+  for (float ms : frame_stats_ms_) {
+    total += ms;
+    over_17 += ms > 17.5f;
+    over_34 += ms > 34.0f;
+    over_50 += ms > 50.0f;
+  }
+  auto pct = [&](double p) { return sorted[std::min(sorted.size() - 1, size_t(p * sorted.size()))]; };
+  // Worst frames in submission order, so drops can be located in time.
+  std::string worst;
+  float threshold = sorted[sorted.size() - std::min<size_t>(sorted.size(), 5)];
+  uint32_t shown = 0;
+  for (size_t i = 0; i < frame_stats_ms_.size() && shown < 5; ++i) {
+    if (frame_stats_ms_[i] >= threshold) {
+      worst += fmt::format(" #{}:{:.1f}", i, frame_stats_ms_[i]);
+      ++shown;
+    }
+  }
+  REXGPU_INFO(
+      "frame times/{}f: avg {:.2f} ms ({:.1f} fps) p50 {:.1f} p95 {:.1f} p99 {:.1f} max {:.1f} | "
+      ">17.5ms {} >34ms {} >50ms {} | vblanks/swap 0:{} 1:{} 2:{} 3+:{} | per frame: cp idle {:.1f} "
+      "ms, wait_reg_mem {:.1f} ms, gpu wait {:.1f} ms | worst{}",
+      frame_stats_ms_.size(), total / frame_stats_ms_.size(), 1000.0 * frame_stats_ms_.size() / total,
+      pct(0.50), pct(0.95), pct(0.99), sorted.back(), over_17, over_34, over_50,
+      frame_stats_vblank_hist_[0], frame_stats_vblank_hist_[1], frame_stats_vblank_hist_[2],
+      frame_stats_vblank_hist_[3], frame_stats_idle_us_ / 1000.0 / frame_stats_ms_.size(),
+      frame_stats_wait_reg_us_ / 1000.0 / frame_stats_ms_.size(),
+      frame_stats_gpu_wait_us_ / 1000.0 / frame_stats_ms_.size(), worst);
+  frame_stats_idle_us_ = frame_stats_wait_reg_us_ = frame_stats_gpu_wait_us_ = 0;
+  frame_stats_ms_.clear();
+  std::fill(std::begin(frame_stats_vblank_hist_), std::end(frame_stats_vblank_hist_), 0u);
+}
