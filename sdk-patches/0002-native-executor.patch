+
+uint32_t NativeExecutor::GpuBegin() {
+  if (!gpu_query_heap_ || !gpu_submission_open_) return UINT32_MAX;
+  GpuProfileSlot& slot = gpu_slots_[gpu_slot_];
+  if (slot.pending || slot.used + 2 > kGpuProfileQueries) return UINT32_MAX;
+  const uint32_t index = gpu_slot_ * kGpuProfileQueries + slot.used++;
+  command_processor_.GetDeferredCommandList().D3DEndQuery(gpu_query_heap_.Get(),
+                                                         D3D12_QUERY_TYPE_TIMESTAMP, index);
+  return index;
+}
+
+void NativeExecutor::GpuEnd(GpuPhase phase, uint32_t begin) {
+  if (begin == UINT32_MAX || !gpu_query_heap_ || !gpu_submission_open_) return;
+  const uint32_t base = gpu_slot_ * kGpuProfileQueries;
+  // A span that began in a slot that has since been closed is dropped.
+  if (begin < base || begin >= base + kGpuProfileQueries) return;
+  GpuProfileSlot& slot = gpu_slots_[gpu_slot_];
+  if (slot.pending || slot.used + 1 > kGpuProfileQueries) return;
+  const uint32_t index = base + slot.used++;
+  command_processor_.GetDeferredCommandList().D3DEndQuery(gpu_query_heap_.Get(),
+                                                         D3D12_QUERY_TYPE_TIMESTAMP, index);
+  slot.spans.emplace_back(phase, begin - base, index - base);
+}
+
+void NativeExecutor::GpuSubmissionBegin() {
+  if (!gpu_query_heap_) return;
+  gpu_submission_open_ = true;
+  gpu_submission_begin_ = GpuBegin();
+}
+
+void NativeExecutor::GpuSubmissionEnd() {
+  if (!gpu_query_heap_ || !gpu_submission_open_) return;
+  GpuEnd(kGpuSubmissions, gpu_submission_begin_);
+  gpu_submission_begin_ = UINT32_MAX;
+  if (gpu_frame_end_requested_) {
+    gpu_frame_end_requested_ = false;
+    GpuProfileSlot& slot = gpu_slots_[gpu_slot_];
+    if (!slot.pending) {
+      if (slot.used) {
+        command_processor_.GetDeferredCommandList().D3DResolveQueryData(
+            gpu_query_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP, gpu_slot_ * kGpuProfileQueries,
+            slot.used, slot.readback.Get(), 0);
+      }
+      slot.submission = command_processor_.GetCurrentSubmission();
+      slot.pending = true;
+      gpu_slot_ = (gpu_slot_ + 1) % kGpuProfileSlots;
+    }
+  }
+  gpu_submission_open_ = false;
+}
+
+void NativeExecutor::GpuDrain() {
+  if (!gpu_query_heap_) return;
+  const uint64_t completed = command_processor_.GetCompletedSubmission();
+  for (GpuProfileSlot& slot : gpu_slots_) {
+    if (!slot.pending || slot.submission > completed) continue;
+    if (slot.used) {
+      void* mapped = nullptr;
+      D3D12_RANGE range = {0, slot.used * sizeof(uint64_t)};
+      if (SUCCEEDED(slot.readback->Map(0, &range, &mapped))) {
+        const auto* ticks = static_cast<const uint64_t*>(mapped);
+        for (const auto& [phase, begin, end] : slot.spans) {
+          if (ticks[end] > ticks[begin]) gpu_ticks_[phase] += ticks[end] - ticks[begin];
+        }
+        D3D12_RANGE written = {0, 0};
+        slot.readback->Unmap(0, &written);
+      }
+    }
+    ++gpu_frames_;
+    slot.used = 0;
+    slot.spans.clear();
+    slot.pending = false;
+  }
+}
+
+void NativeExecutor::OnSwap(uint64_t frame) {
+  if (!initialized_) return;
+  gpu_frame_end_requested_ = true;
+  GpuDrain();
+  frame_ = frame;
+  if (frame >= last_stats_frame_ + 300) {
+    last_stats_frame_ = frame;
+    LogStats(frame);
+  }
+}
+
+void NativeExecutor::LogStats(uint64_t frame) {
+  REXGPU_INFO(
+      "native executor frame={} draws={} resolves={} surfaces={} skips={{{}}} stats={{{}}}",
+      frame, draws_, resolves_, surfaces_.size(), counters_.FormatSkips(),
+      counters_.FormatStats());
+  if (!skipped_resolve_kinds_.empty()) {
+    std::string kinds;
+    for (const auto& [kind, count] : skipped_resolve_kinds_) {
+      kinds += (kinds.empty() ? "" : ",") + kind + "=" + std::to_string(count);
+    }
+    REXGPU_INFO("native executor skipped resolves by kind: {}", kinds);
+  }
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  uint64_t surface_bytes = 0;
+  for (const auto& [packed, surface] : surfaces_) {
+    const D3D12_RESOURCE_DESC desc = surface.resource->GetDesc();
+    surface_bytes += device->GetResourceAllocationInfo(0, 1, &desc).SizeInBytes;
+  }
+  REXGPU_INFO("native executor memory MB: surfaces {} transfer_words {}", surface_bytes >> 20,
+              transfer_words_size_ >> 20);
+  if (gpu_frames_ && gpu_timestamp_frequency_) {
+    const double scale = 1000.0 / double(gpu_timestamp_frequency_) / double(gpu_frames_);
+    const double total = gpu_ticks_[kGpuSubmissions] * scale;
+    const double transfers = gpu_ticks_[kGpuTransfers] * scale;
+    const double resolves = gpu_ticks_[kGpuResolves] * scale;
+    const double clears = gpu_ticks_[kGpuClears] * scale;
+    const double readback = gpu_ticks_[kGpuReadback] * scale;
+    REXGPU_INFO(
+        "native executor gpu ms/frame over {} frames: submissions {:.2f} (transfers {:.2f} "
+        "resolves {:.2f} clears {:.2f} readback copies {:.2f} other/draws {:.2f})",
+        gpu_frames_, total, transfers, resolves, clears, readback,
+        total - transfers - resolves - clears - readback);
+    gpu_ticks_ = {};
+    gpu_frames_ = 0;
+  }
+  if (!transfer_volume_.empty()) {
+    std::vector<std::pair<uint64_t, std::string>> volume;
+    for (const auto& [pair, tiles] : transfer_volume_) volume.emplace_back(tiles, pair);
+    std::sort(volume.rbegin(), volume.rend());
+    std::string top;
+    for (size_t i = 0; i < std::min<size_t>(volume.size(), 10); ++i) {
+      top += volume[i].second + "=" + std::to_string(volume[i].first) + " ";
+    }
+    REXGPU_INFO("native executor transfer tile-passes (base/pitch/msaa/kind+format): {}", top);
+    transfer_volume_.clear();
+  }
+}
