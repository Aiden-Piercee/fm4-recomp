From 309a5ebbca896ee5ab9ccb3a19bc9fbfa74bb913 Mon Sep 17 00:00:00 2001
From: perf <perf@local>
Date: Fri, 16 Oct 2026 02:35:58 +0000
Subject: [PATCH] perf: break texture hitch time into create/upload/load and
 count evictions

---
 include/rex/graphics/pipeline/texture/cache.h | 23 ++++++
 src/graphics/d3d12/command_processor.cpp      | 15 ++++
 src/graphics/pipeline/texture/cache.cpp       | 70 +++++++++++++++++--
 3 files changed, 102 insertions(+), 6 deletions(-)

diff --git a/include/rex/graphics/pipeline/texture/cache.h b/include/rex/graphics/pipeline/texture/cache.h
index 9bad85a..6c46e75 100644
--- a/include/rex/graphics/pipeline/texture/cache.h
+++ b/include/rex/graphics/pipeline/texture/cache.h
@@ -134,6 +134,27 @@ class TextureCache {
            (binding->texture_signed && binding->texture_signed->key().scaled_resolve);
   }
 
+  // Per-frame texture-path timing for hitch logging (frame_hitch_log_ms).
+  struct HitchStats {
+    uint64_t create_us = 0;
+    uint64_t upload_us = 0;
+    uint64_t scaled_commit_us = 0;
+    uint64_t load_us = 0;
+    uint64_t upload_bytes = 0;
+    uint32_t created = 0;
+    uint32_t loaded = 0;
+    uint32_t scaled_loaded = 0;
+    uint32_t evicted = 0;
+  };
+  void SetHitchTiming(bool enable) {
+    hitch_timing_ = enable;
+    hitch_stats_ = HitchStats();
+  }
+  const HitchStats& hitch_stats() const { return hitch_stats_; }
+  uint64_t textures_total_host_memory_usage_mb() const {
+    return (textures_total_host_memory_usage_ + ((UINT64_C(1) << 20) - 1)) >> 20;
+  }
+
  protected:
   struct TextureKey {
     // Dimensions minus 1 are stored similarly to how they're stored in fetch
@@ -557,6 +578,8 @@ class TextureCache {
   virtual void UpdateTextureBindingsImpl(uint32_t /*fetch_constant_mask*/) {}
 
  private:
+  bool hitch_timing_ = false;
+  HitchStats hitch_stats_;
   struct PendingTextureLoad {
     Texture* texture = nullptr;
     bool load_base = false;
diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 0e73141..fad0f23 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -2390,6 +2390,18 @@ std::string D3D12CommandProcessor::FrameHitchDetails() const {
   }
   details += fmt::format(" | draws={} resolves={} submissions={}", hitch_draws_, hitch_resolves_,
                          hitch_submissions_);
+  if (texture_cache_) {
+    const D3D12TextureCache::HitchStats& tex = texture_cache_->hitch_stats();
+    if (tex.created || tex.loaded || tex.evicted) {
+      details += fmt::format(
+          " | tex: create={:.1f}ms/{} upload={:.1f}ms/{:.1f}MB scaled_commit={:.1f}ms "
+          "load={:.1f}ms/{} ({} scaled) evicted={} cache={}MB",
+          tex.create_us / 1000.0, tex.created, tex.upload_us / 1000.0,
+          tex.upload_bytes / (1024.0 * 1024.0), tex.scaled_commit_us / 1000.0,
+          tex.load_us / 1000.0, tex.loaded, tex.scaled_loaded, tex.evicted,
+          texture_cache_->textures_total_host_memory_usage_mb());
+    }
+  }
   return details;
 }
 
@@ -2397,6 +2409,9 @@ void D3D12CommandProcessor::ResetFrameHitchDetails(bool enable_timing) {
   hitch_timing_ = enable_timing;
   std::fill(std::begin(hitch_us_), std::end(hitch_us_), uint64_t(0));
   hitch_draws_ = hitch_resolves_ = hitch_submissions_ = 0;
+  if (texture_cache_) {
+    texture_cache_->SetHitchTiming(enable_timing);
+  }
 }
 
 void D3D12CommandProcessor::OnPrimaryBufferEnd() {
diff --git a/src/graphics/pipeline/texture/cache.cpp b/src/graphics/pipeline/texture/cache.cpp
index ebef1aa..0194224 100644
--- a/src/graphics/pipeline/texture/cache.cpp
+++ b/src/graphics/pipeline/texture/cache.cpp
@@ -10,6 +10,7 @@
  */
 
 #include <algorithm>
+#include <chrono>
 #include <cstdint>
 #include <utility>
 
@@ -127,6 +128,29 @@ REXCVAR_DEFINE_BOOL(pre_mask_resolve_l2_block, true, "GPU",
 
 namespace rex::graphics {
 
+namespace {
+// Adds the elapsed time to *slot on destruction; does nothing when slot is null.
+class TextureHitchTimer {
+ public:
+  explicit TextureHitchTimer(uint64_t* slot) : slot_(slot) {
+    if (slot_) {
+      begin_ = std::chrono::steady_clock::now();
+    }
+  }
+  ~TextureHitchTimer() {
+    if (slot_) {
+      *slot_ += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                             std::chrono::steady_clock::now() - begin_)
+                             .count());
+    }
+  }
+
+ private:
+  uint64_t* slot_;
+  std::chrono::steady_clock::time_point begin_;
+};
+}  // namespace
+
 const TextureCache::LoadShaderInfo TextureCache::load_shader_info_[kLoadShaderCount] = {
     // k8bpb
     {3, 4, 1, 4},
@@ -293,6 +317,9 @@ void TextureCache::CompletedSubmissionUpdated(uint64_t completed_submission_inde
     if (found_texture_it != textures_.end()) {
       assert_true(found_texture_it->second.get() == texture);
       textures_.erase(found_texture_it);
+      if (hitch_timing_) {
+        ++hitch_stats_.evicted;
+      }
       // `texture` is invalid now.
     }
   }
@@ -416,7 +443,14 @@ bool TextureCache::CommitPreparedTextureLoad(const PendingTextureLoad& pending_l
 
   Texture& texture = *pending_load.texture;
   TextureKey texture_key = texture.key();
+  if (hitch_timing_) {
+    ++hitch_stats_.loaded;
+    if (texture_key.scaled_resolve) {
+      ++hitch_stats_.scaled_loaded;
+    }
+  }
   if (texture_key.scaled_resolve) {
+    TextureHitchTimer hitch_timer(hitch_timing_ ? &hitch_stats_.scaled_commit_us : nullptr);
     // Make sure all the scaled resolve memory is resident and accessible from
     // the shader, including any possible padding that hasn't yet been touched
     // by an actual resolve, but is still included in the texture size, so the
@@ -431,9 +465,12 @@ bool TextureCache::CommitPreparedTextureLoad(const PendingTextureLoad& pending_l
     }
   }
 
-  if (!LoadTextureDataFromResidentMemoryImpl(texture, pending_load.load_base,
-                                             pending_load.load_mips)) {
-    return false;
+  {
+    TextureHitchTimer hitch_timer(hitch_timing_ ? &hitch_stats_.load_us : nullptr);
+    if (!LoadTextureDataFromResidentMemoryImpl(texture, pending_load.load_base,
+                                               pending_load.load_mips)) {
+      return false;
+    }
   }
 
   // Mark the ranges as uploaded and watch them. This is needed for scaled
@@ -573,6 +610,12 @@ void TextureCache::RequestTextures(uint32_t used_texture_mask) {
     for (const PendingSharedMemoryRange& pending_range : pending_shared_memory_ranges) {
       pending_shared_memory_range_pairs.emplace_back(pending_range.start, pending_range.length);
     }
+    TextureHitchTimer hitch_timer(hitch_timing_ ? &hitch_stats_.upload_us : nullptr);
+    if (hitch_timing_) {
+      for (const auto& range_pair : pending_shared_memory_range_pairs) {
+        hitch_stats_.upload_bytes += range_pair.second;
+      }
+    }
     batched_shared_memory_request_succeeded = shared_memory().RequestRanges(
         pending_shared_memory_range_pairs.data(), pending_shared_memory_range_pairs.size());
   }
@@ -867,7 +910,14 @@ TextureCache::Texture* TextureCache::FindOrCreateTexture(TextureKey key) {
   // Create the texture and add it to the map.
   Texture* texture;
   {
-    std::unique_ptr<Texture> new_texture = CreateTexture(key);
+    std::unique_ptr<Texture> new_texture;
+    {
+      TextureHitchTimer hitch_timer(hitch_timing_ ? &hitch_stats_.create_us : nullptr);
+      new_texture = CreateTexture(key);
+    }
+    if (hitch_timing_) {
+      ++hitch_stats_.created;
+    }
     if (!new_texture) {
       key.LogAction("Failed to create");
       return nullptr;
@@ -929,8 +979,16 @@ bool TextureCache::LoadTextureData(Texture& texture) {
   for (size_t i = 0; i < pending_range_count; ++i) {
     pending_range_pairs[i] = std::make_pair(pending_ranges[i].start, pending_ranges[i].length);
   }
-  if (!shared_memory().RequestRanges(pending_range_pairs, pending_range_count)) {
-    return false;
+  {
+    TextureHitchTimer hitch_timer(hitch_timing_ ? &hitch_stats_.upload_us : nullptr);
+    if (hitch_timing_) {
+      for (size_t i = 0; i < pending_range_count; ++i) {
+        hitch_stats_.upload_bytes += pending_range_pairs[i].second;
+      }
+    }
+    if (!shared_memory().RequestRanges(pending_range_pairs, pending_range_count)) {
+      return false;
+    }
   }
 
   return CommitPreparedTextureLoad(pending_load);
-- 
2.34.1

